# .env.example — Solace LLM Gateway Configuration
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Groq (OpenAI-compatible) ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# ── OpenRouter (OpenAI-compatible) ───────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# ── Mistral (OpenAI-compatible) ──────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ── Cerebras (OpenAI-compatible) ─────────────────────────────────────────────
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama3.1-8b

# ── Per-provider daily call caps (soft limits, stored in SQLite) ──────────────
GEMINI_DAILY_CAP=1500
GROQ_DAILY_CAP=1500
OPENROUTER_DAILY_CAP=200
MISTRAL_DAILY_CAP=500
CEREBRAS_DAILY_CAP=1000

# ── Gateway resilience ────────────────────────────────────────────────────────
# Seconds to back off after a provider returns 429
PROVIDER_COOLDOWN_SECONDS=60
# Maximum retry attempts per provider before falling through
GATEWAY_MAX_RETRIES=3
# Base delay (seconds) for exponential backoff
GATEWAY_BACKOFF_BASE=1.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/solace.db

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
