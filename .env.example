# .env.example — Solace LLM Gateway Configuration
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (OpenAI-compatible) ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ── OpenRouter (OpenAI-compatible) ───────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-small-2603

# ── Mistral (OpenAI-compatible) ──────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ── Cerebras (OpenAI-compatible) ─────────────────────────────────────────────
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=qwen-3.8-27b

# ── Per-provider daily call caps (local protective caps, stored in SQLite) ────
# These conservative defaults are configurable and are not provider quota claims.
GEMINI_DAILY_CAP=20
GROQ_DAILY_CAP=20
OPENROUTER_DAILY_CAP=20
MISTRAL_DAILY_CAP=20
CEREBRAS_DAILY_CAP=20

# ── Gateway resilience ────────────────────────────────────────────────────────
# Seconds to back off after a provider returns 429
PROVIDER_COOLDOWN_SECONDS=60
# Maximum retry attempts per provider before falling through
GATEWAY_MAX_RETRIES=3
# Base delay (seconds) for exponential backoff
GATEWAY_BACKOFF_BASE=1.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/solace.db

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
