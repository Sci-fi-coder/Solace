GROQ_BASE_URL=
GROQ_MODEL=
GROQ_ENABLED=
GROQ_DAILY_CAP=

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_ENABLED=
OPENROUTER_DAILY_CAP=

# Mistral (OpenAI-compatible)
