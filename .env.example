# Copy this file to .env and fill in only the settings you want to override.
# Blank values are ignored; application defaults remain in app/config.py.

# App and database
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLED=
GEMINI_DAILY_CAP=

# Groq (OpenAI-compatible)
